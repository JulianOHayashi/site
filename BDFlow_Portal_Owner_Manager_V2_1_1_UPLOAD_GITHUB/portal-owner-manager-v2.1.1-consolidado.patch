+);
+
+{
+  const conv: ManagerInvitation = {
+    invitationId: "i1",
+    batchId: "batch-abc12345",
+    label: "Turno da manhã",
+    url: "https://exemplo/portal/convites/T1",
+    createdAt: criado,
+    expiresAt: expira,
+    status: "not_used",
+    usedAt: null,
+    usedByMemberId: null,
+    usedByName: null,
+  };
