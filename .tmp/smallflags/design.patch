+@layer base {
+  html {
+    scroll-behavior: smooth;
+    -webkit-tap-highlight-color: transparent;
+  }
+
+  body {
+    @apply bg-papel font-body text-tinta antialiased;
+    font-feature-settings: "cv11", "ss01";
+    text-rendering: optimizeLegibility;
+  }
+
+  h1,
+  h2,
+  h3,
+  h4,
+  .display {
+    @apply font-display font-bold tracking-tight text-tinta;
+    text-wrap: balance;
+  }
+
+  p {
+    text-wrap: pretty;
+  }
+
+  /* Campos de formulário padronizados em um só lugar.
+     Utilitários locais (largura, padding) continuam valendo; aqui ficam
+     cor, borda, foco, placeholder e estado desabilitado. */
+  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not([type="color"]),
+  select,
+  textarea {
+    @apply border-borda bg-superficie text-tinta;
+    transition:
+      border-color 150ms var(--sf-ease),
+      box-shadow 150ms var(--sf-ease),
+      background-color 150ms var(--sf-ease);
+  }
+  input::placeholder,
+  textarea::placeholder {
+    color: rgb(var(--sf-muted) / 0.8);
+  }
+  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not([type="color"]):hover:not(:disabled),
+  select:hover:not(:disabled),
+  textarea:hover:not(:disabled) {
+    @apply border-borda-forte;
+  }
+  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not([type="color"]):focus-visible,
+  select:focus-visible,
+  textarea:focus-visible {
+    outline: none;
+    border-color: rgb(var(--sf-ciano));
+    box-shadow: 0 0 0 3px rgb(var(--sf-ciano) / 0.25);
+  }
+  input[aria-invalid="true"],
+  select[aria-invalid="true"],
+  textarea[aria-invalid="true"] {
+    border-color: rgb(var(--sf-vermelho));
+  }
+  input:disabled,
+  select:disabled,
+  textarea:disabled {
+    @apply cursor-not-allowed bg-papel text-tinta/50;
+  }
+  select option {
+    @apply bg-superficie text-tinta;
+  }
+  input[type="checkbox"],
+  input[type="radio"] {
+    accent-color: rgb(var(--sf-ciano));
+    width: 1.05rem;
+    height: 1.05rem;
+  }
+  input[type="file"] {
+    @apply text-sm text-tinta/70;
+  }
+  input[type="file"]::file-selector-button {
+    @apply mr-3 cursor-pointer rounded-lg border border-borda-forte bg-superficie2 px-3 py-2 text-sm font-semibold text-tinta;
+  }
+
+  code,
+  kbd {
+    @apply rounded-md bg-superficie2 px-1.5 py-0.5 text-[0.9em];
+  }
+
+  hr {
+    @apply border-borda;
+  }
 }
 
