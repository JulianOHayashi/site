# Opcional — o site roda com dados de demonstração sem isso.
# Preencha para conectar ao Supabase (estoque real + pedidos).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CAPTCHA do Supabase Auth (Cloudflare Turnstile) — SOMENTE a site key PÚBLICA.
# Obrigatória em build de Production: sem ela, login, cadastro e reset de senha
# ficam bloqueados (fail-closed). O SECRET do Turnstile NÃO vai aqui nem em
# nenhum VITE_*: ele é configurado só no Supabase Dashboard
# (Authentication → Bot and Abuse Protection → CAPTCHA).
VITE_TURNSTILE_SITE_KEY=

# --- Worker da ponte Site->App (R11, camadas 2-3) ---
# APENAS NOMES. Nunca versione valores reais.
# ATENÇÃO: mesmo configuradas, a ponte permanece BLOCKED_APP_REPOSITORY
# enquanto o contrato real da API do App não puder ser inspecionado.
BDFLOW_APP_BRIDGE_URL=
BDFLOW_APP_BRIDGE_KEY_ID=
BDFLOW_APP_BRIDGE_SIGNING_KEY=
BDFLOW_APP_BRIDGE_ISSUER=
BDFLOW_APP_BRIDGE_AUDIENCE=

# --- Worker do outbox de e-mail (R16) ---
# APENAS NOMES. Nunca versione valores reais.
# Segredo sob prefixo VITE_ ou NEXT_PUBLIC_ é REJEITADO na inicialização.
ENVIRONMENT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_BASE_URL=
SMTP_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_CONNECT_TIMEOUT_MS=
SMTP_READ_TIMEOUT_MS=
WORKER_BATCH_SIZE=
WORKER_RECOVERY_RESERVE=
WORKER_POLL_INTERVAL_MS=
WORKER_ONE_SHOT=
# Obrigatória em staging: exatamente UMA das duas.
STAGING_RECIPIENT_OVERRIDE=
STAGING_RECIPIENT_ALLOWLIST=

# Provedor de pagamento (somente servidor, sem prefixo VITE_)
PAGARME_SECRET_KEY=
PAGARME_API_BASE_URL=

# Host do Checkout/Payment Link. Teste documentado: https://sdx-api.pagar.me/core/v5
# Omitido, acompanha PAGARME_API_BASE_URL (producao por padrao).
PAGARME_CHECKOUT_BASE_URL=

# --- Invocação agendada do worker de e-mail (Vercel Cron) ---
# Somente servidor. NUNCA com prefixo VITE_. Mínimo 16 caracteres aleatórios.
# O Vercel Cron envia "Authorization: Bearer <CRON_SECRET>" para
# /api/internal/email-outbox-dispatch; sem ele o endpoint responde 401.
CRON_SECRET=
