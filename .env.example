# Opcional — o site roda com dados de demonstração sem isso.
# Preencha para conectar ao Supabase (estoque real + pedidos).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Worker da ponte Site->App (R11, camadas 2-3) ---
# APENAS NOMES. Nunca versione valores reais.
# ATENÇÃO: mesmo configuradas, a ponte permanece BLOCKED_APP_REPOSITORY
# enquanto o contrato real da API do App não puder ser inspecionado.
BDFLOW_APP_BRIDGE_URL=
BDFLOW_APP_BRIDGE_KEY_ID=
BDFLOW_APP_BRIDGE_SIGNING_KEY=
BDFLOW_APP_BRIDGE_ISSUER=
BDFLOW_APP_BRIDGE_AUDIENCE=

# --- Worker do outbox de e-mail (R16) ---
# APENAS NOMES. Nunca versione valores reais.
# Segredo sob prefixo VITE_ ou NEXT_PUBLIC_ é REJEITADO na inicialização.
ENVIRONMENT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_BASE_URL=
SMTP_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_CONNECT_TIMEOUT_MS=
SMTP_READ_TIMEOUT_MS=
WORKER_BATCH_SIZE=
WORKER_RECOVERY_RESERVE=
WORKER_POLL_INTERVAL_MS=
WORKER_ONE_SHOT=
# Obrigatória em staging: exatamente UMA das duas.
STAGING_RECIPIENT_OVERRIDE=
STAGING_RECIPIENT_ALLOWLIST=
