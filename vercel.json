{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/selecionar-estado",
      "destination": "/selecionar-localidade",
      "permanent": true
    },
    {
      "source": "/previa/precos-bandeiras",
      "destination": "/oportunidades",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/oportunidades/:nicheSlug",
      "destination": "/_seo/oportunidade-nicho"
    },
    {
      "source": "/beneficios/validar/:publicLookupId",
      "destination": "/_seo/beneficio-validar"
    },
    {
      "source": "/portal/pedidos/:orderId/personalizacao",
      "destination": "/_seo/portal-pedido"
    },
    {
      "source": "/portal/pedidos/:orderId/alteracao-arte",
      "destination": "/_seo/portal-pedido"
    }
  ],
  "headers": [
    {
      "source": "/oportunidades",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/oportunidades/:nicheSlug",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
