{
  "name": "bdflow-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:legacy": "node scripts/check-no-legacy.mjs",
    "test": "vitest run",
    "validate": "npm run check:legacy && npm run typecheck && npm run test && npm run build && npm run build:worker",
    "db:reset:aux": "bash scripts/db-test/reset-local.sh",
    "db:test:aux": "bash scripts/db-test/run-sql-tests.sh",
    "build:worker": "vite build --config vite.worker.config.ts",
    "worker": "node dist-worker/main.mjs",
    "worker:once": "node dist-worker/main.mjs --once"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "26.1.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "3.2.7"
  }
}
